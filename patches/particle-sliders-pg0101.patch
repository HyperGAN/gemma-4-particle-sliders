+        # response-domain gate above; forward the switch only where supported.
+        penalty_options = ({'input_domain': 'continuous'}
+                           if penalty_input_domain == 'continuous'
+                           and self.recipe.effective_critic_formulation != 'rhbi' else {})
+        self.penalty = self.recipe.make_critic_penalty(self.opt_d, collect_stats=True, **penalty_options)
