@@ -0,0 +1,39 @@
+"""New source cohort: paired response semantics, no EMA and strict continuation."""
+from copy import deepcopy
+import pytest
+import torch
+import test_conditional_pg09 as fixture_module
+from particle_sliders.pg0100 import ConditionalPG0100, _released_sources
+
+@pytest.mark.parametrize('preset', ['rhbi_optimized', 'empf'])
+def test_two_updates_and_exact_continuation(monkeypatch,preset):
+    torch.set_num_threads(1)
+    monkeypatch.setattr(fixture_module,'ConditionalPG09',ConditionalPG0100)
+    game=fixture_module.fixture(preset=preset)
+    assert game.recipe.ema_decay == 0
+    assert game.signature['session_ema_decay'] is None
+    before=deepcopy(game.network.state_dict())
+    game.step()
+    packet=game.state_dict()
+    expected=game.step()
+    expected_packet=game.state_dict()
+    other=fixture_module.fixture(preset=preset)
+    other.load_state_dict(packet)
+    actual=other.step()
+    fixture_module.equal(expected,actual)
+    fixture_module.equal(expected_packet,other.state_dict())
+    assert any(not torch.equal(before[n],p) for n,p in game.network.state_dict().items())
+    assert game.penalty.regularizer.record is game.opt_d.record
+    assert game.spread is None or getattr(game.spread,'thermal_source',game.opt_d.record) is game.opt_d.record
+
+
+def test_source_and_recipe_boundaries(monkeypatch):
+    monkeypatch.setattr(fixture_module,'ConditionalPG09',ConditionalPG0100)
+    assert len(_released_sources()) == 64
+    with pytest.raises(ValueError):
+        fixture_module.fixture(preset='bispf_optimized')
+    for name in ['rhbi_optimized','empf']:
+        game=fixture_module.fixture(preset=name)
+        packet=game.state_dict()
+        packet['config']['pg_version']='0.9.5'
+        with pytest.raises(ValueError):game.load_state_dict(packet)
